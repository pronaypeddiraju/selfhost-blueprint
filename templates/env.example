# ============================================================================
# selfhost-blueprint — environment template
# Copy to `.env` (git-ignored) and fill in your values:
#   cp templates/env.example .env
# OR run ./configure.sh (interactive scaffolding).
#
# WARNING: `.env` is git-ignored. NEVER commit real values.
# ============================================================================

# --- General ---------------------------------------------------------------
# Your public domain, used for wildcard TLS certs (e.g. example.com).
# Leave blank if you will NOT use public DNS/TLS (LAN-only or self-signed).
APP_DOMAIN=

# --- TLS mode -------------------------------------------------------------
# One of: none | internal | dns01   (default: internal)
#   none     = plain HTTP. Quickest preview. NOTE: Vaultwarden will NOT work
#              (the web vault needs a secure context), Bitwarden apps refuse HTTP.
#   internal = Caddy's own local CA. Real https:// on your LAN with no domain
#              purchase. Requires installing Caddy's root cert on each device
#              (see docs/06-tls.md).
#   dns01    = wildcard cert via Cloudflare DNS-01. Needs APP_DOMAIN + a
#              Cloudflare API token. No inbound ports, works off-LAN.
TLS_MODE=internal

# Your machine's LAN IP (the host that runs these services).
HOST_IP=

# Your LAN subnet in CIDR form (e.g. 192.168.1.0/24). Used by firewall rules
# and some container configs. Private RFC1918 ranges are the only ones allowed
# in this repo.
LAN_SUBNET=

# LAN gateway, if needed.
LAN_GATEWAY=

# Timezone (e.g. America/New_York, UTC).
TZ=UTC

# --- Storage ---------------------------------------------------------------
# 'zfs' = use ZFS datasets (Proxmox home-server; see platform/).
# 'dir' = use a plain directory (laptop / any Linux).
STORAGE_TYPE=dir

# Base directory when STORAGE_TYPE=dir (must be writable). For zfs this is the
# mountpoint root that datasets hang below.
DATA_DIR=/srv/selfhost

# --- Platform --------------------------------------------------------------
# 'proxmox' hosts may create unprivileged LXC containers + ZFS via platform/.
# Set to 'none' on a plain machine.
PLATFORM=none

# --- GPU (auto-detected if left blank) -------------------------------------
# 'nvidia' | 'intel' | 'none' | 'auto'
# Immich and Jellyfin use this to enable or skip GPU acceleration.
GPU_MODE=auto

# --- Docker ----------------------------------------------------------------
# Prefix applied to container/project names so multiple hosts don't collide.
DOCKER_PREFIX=

# Docker network that services share (so they can resolve each other by name).
DOCKER_NETWORK=selfhost

# --- DNS / AdGuard ---------------------------------------------------------
# Port AdGuard's admin UI listens on (host).
ADGUARD_HTTP_PORT=3000
ADGUARD_DNS_PORT=53

# --- Reverse proxy / Caddy -------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# DNS-01 challenge provider. 'cloudflare' is the common one.
# Requires a provider API token (real value goes in .env, NOT here).
ACME_DNS_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=

# --- Media stack (gluetun + arr apps) --------------------------------------
# gluetun VPN provider + WireGuard credentials. Fill with YOUR provider's values.
VPN_PROVIDER=
VPN_PRIVATE_KEY=
VPN_ADDRESS=
VPN_PUBLIC_KEY=
VPN_PORT_FORWARDED=

# Service ports (host side). Leave as defaults unless you have conflicts.
QBIT_HTTP_PORT=8080
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
BAZARR_PORT=6767
JELLYSEERR_PORT=5055

# --- Immich ----------------------------------------------------------------
# Random value (generate with: openssl rand -base64 24).
IMMICH_HTTP_PORT=2283
IMMICH_DB_PASSWORD=

# --- Jellyfin --------------------------------------------------------------
JELLYFIN_HTTP_PORT=8096

# --- Vaultwarden -----------------------------------------------------------
VAULTWARDEN_HTTP_PORT=8000
VAULTWARDEN_ADMIN_TOKEN=

# --- Mealie (recipe manager) ------------------------------------------------
MEALIE_HTTP_PORT=9925
# Random value required by Mealie (openssl rand -base64 32).
MEALIE_SECRET=

# --- Uptime Kuma (monitoring) ----------------------------------------------
UPTIMEKUMA_HTTP_PORT=3001

# --- SilverBullet (knowledge base) ------------------------------------------
SILVERBULLET_HTTP_PORT=3030
# Web editor login, format "username:password" (the ONLY authentication).
SILVERBULLET_USER=

# --- FileBrowser (web file manager) -----------------------------------------
FILEBROWSER_HTTP_PORT=8082

# --- Homepage (dashboard) ---------------------------------------------------
HOMEPAGE_HTTP_PORT=3002
# Hostname(s) the dashboard is reached on; '*' is fine on a trusted LAN.
HOMEPAGE_ALLOWED_HOSTS=*

# --- Scrutiny (drive health / SMART) ---------------------------------------
SCRUTINY_HTTP_PORT=8081

# --- Hermes (self-hosted agent) --------------------------------------------
# API keys / tokens for the model provider(s) and messaging gateways.
HERMES_PROVIDER_API_KEY=
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_CHAT_ID=
# WhatsApp is optional and needs a paired session; leave these unset unless you
# want it. (Shell-comment, not a variable: a literal '*' is not a valid assignment.)
# HERMES_WHATSAPP_SESSION=

# --- Backups ---------------------------------------------------------------
# Directory backups land here (when not using ZFS snapshots).
BACKUP_DIR=
# Retention (how many of each to keep).
BACKUP_DAILY=14
BACKUP_WEEKLY=4
BACKUP_MONTHLY=6
# Optional offsite destination for replication (e.g. ssh host). Leave blank
# for local-only backups.
REPLICATION_TARGET=
